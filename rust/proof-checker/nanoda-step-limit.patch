diff --git a/src/fuel.rs b/src/fuel.rs
new file mode 100644
index 0000000..74da468
--- /dev/null
+++ b/src/fuel.rs
@@ -0,0 +1,25 @@
+//! Deterministic step budget for NIR proof mining.
+//!
+//! Every entry to type inference, weak-head normalization and definitional
+//! equality, and every unfolding round inside `whnf`, costs one step. Checking
+//! is serial, the caches are deterministic, and hashing uses no random seed,
+//! so the same export costs the same number of steps on every machine. A
+//! wall-clock limit would not: two honest nodes could disagree.
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+
+static STEPS: AtomicU64 = AtomicU64::new(0);
+static LIMIT: AtomicU64 = AtomicU64::new(0);
+
+/// Sets the budget; `0` means unlimited.
+pub fn set_limit(limit: u64) { LIMIT.store(limit, Relaxed) }
+
+pub fn steps() -> u64 { STEPS.load(Relaxed) }
+
+#[inline]
+pub fn tick() {
+    let used = STEPS.fetch_add(1, Relaxed) + 1;
+    let limit = LIMIT.load(Relaxed);
+    if limit != 0 && used > limit {
+        panic!("step limit of {} exceeded", limit)
+    }
+}
