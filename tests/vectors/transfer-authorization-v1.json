      "envelope": { "algorithm": "ml-dsa-65", "approvals": [{ "publicKey": "cHViLWE=", "signature": "c2lnLWE=" }], "transactionDigest": "eb4f0971fb30bb360ca0db2ea7a58a0871a82d89757b623f7cc129f73e2f6245" },
      "error": "algorithm mismatch"
