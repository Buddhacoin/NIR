      "envelope": { "algorithm": "ml-dsa-65", "approvals": [{ "publicKey": "cHViLWE=", "signature": "c2lnLWE=" }], "transactionDigest": "a57e81bb770c68ef5955fb65d54a1273616806c013cbf3d15a51633ebcbccd7a" },
      "expectedSigners": ["cHViLWE="]
