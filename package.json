{
  "name": "nir-protocol",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "demo:chain": "node blockchain/demo.mjs",
    "mine:demo": "node blockchain/demo.mjs",
    "vault:create": "node blockchain/vault-cli.mjs create",
    "vault:verify": "node blockchain/vault-cli.mjs verify",
    "wallet:create": "node blockchain/wallet-cli.mjs create",
    "wallet:address": "node blockchain/wallet-cli.mjs address",
    "wallet:sign": "node blockchain/wallet-cli.mjs sign",
    "wallet:bridge": "node blockchain/wallet-bridge-cli.mjs",
    "beacon:serve": "node blockchain/beacon-service.mjs",
    "beacon:aggregate": "node blockchain/beacon-aggregate.mjs",
    "progress-beacon:aggregate": "node blockchain/beacon-aggregate.mjs progress",
    "node:init-dev": "node blockchain/node-cli.mjs init-dev",
    "node:serve": "node blockchain/node-cli.mjs serve",
    "node:backup": "node blockchain/node-cli.mjs backup",
    "node:verify-backup": "node blockchain/node-cli.mjs verify-backup",
    "node:snapshot-install": "node blockchain/node-cli.mjs snapshot-install",
    "node:prune-stage": "node blockchain/node-cli.mjs prune-stage",
    "node:prune-verify": "node blockchain/node-cli.mjs prune-verify",
    "node:prune-finalize": "node blockchain/node-cli.mjs prune-finalize",
    "archive:create": "node blockchain/archive-cli.mjs create",
    "archive:restore": "node blockchain/archive-cli.mjs restore",
    "network:init-dev": "node blockchain/network-cli.mjs init-dev",
    "network:validator": "node blockchain/network-cli.mjs serve-validator",
    "network:coordinator": "node blockchain/network-cli.mjs serve-coordinator",
    "network:discover": "node blockchain/network-cli.mjs discover",
    "release:create": "node blockchain/release-cli.mjs create",
    "release:sign": "node blockchain/release-cli.mjs sign",
    "release:verify": "node blockchain/release-cli.mjs verify",
    "release:build": "node blockchain/release-cli.mjs build",
    "release:verify-artifact": "node blockchain/release-cli.mjs verify-artifact",
    "release:install-wallet": "node blockchain/release-cli.mjs install-wallet",
    "release:build-extension": "node blockchain/release-cli.mjs build-extension",
    "release:verify-extension": "node blockchain/release-cli.mjs verify-extension",
    "wallet:preview": "python3 -m http.server 8765 --directory wallet-ui",
    "test:chain": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:python": "python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "verify": "npm run test:python && npm run test:chain"
  }
}
